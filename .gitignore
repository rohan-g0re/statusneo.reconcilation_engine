__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated artefacts -- reproducible from a seeded run
data/generated/
*.sqlite
*.sqlite3
*.db
# SQLite write-ahead sidecars. They appear beside any open database and are
# never content -- deleting them mid-session is safe once the server is stopped.
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# decision_tree intermediates. `build_tree.py` regenerates both byte-identically
# in under a second, nothing outside decision_tree/ reads them, and together they
# are 7.4 MB of a repository somebody has to clone. The two artefacts that ARE
# load-bearing -- leaves_classified.json (read by the generator and the engine's
# oracle test) and pairs.json (the live verdict-pair oracle) -- stay tracked.
decision_tree/tree.json
decision_tree/leaves.json

.DS_Store
Thumbs.db
.idea/
*.swp

# Front-end build output and dependencies
web/node_modules/
web/dist/

# Playwright MCP session debris and ad-hoc screenshots from browser validation
.playwright-mcp/
*.png
ui-review/
# ...except the screenshots the design note presents from, which are content.
!docs/images/*.png
# ...and the pitch artwork. SOLUTION_PITCH.md and docs/pitch/deck/index.html both
# reference these by relative path, so ignoring them commits two documents with
# broken images. The .pptx embeds its copies and does not depend on these.
!docs/pitch/diagrams/*.png
!docs/pitch/deck/img/*.png
# ...and the UI brief's screenshots. EXECUTIVE_UI_BRIEF.md references every one by
# relative path; the .pdf embeds its own copies and does not depend on these.
!docs/product/img/*.png

# Office lock/owner files. PowerPoint drops a ~$name.pptx beside any open deck;
# it is a few bytes of session state and never content.
~$*

# Agent layer: secrets and run journals
.env
data/agent_runs/
.agents/specs/

# Local Claude Code permission grants. Auto-generated, machine-specific, and it
# records approved shell commands verbatim -- which is how an API key ended up
# committed inside a curl invocation.
.claude/settings.local.json

# `.agents/skills/` STAYS TRACKED. It looks like a duplicate of `.claude/skills/` and
# is not: `.claude/skills/memory-systems` and `.claude/skills/remember` are SYMLINKS
# pointing here. A `cmp` between the two trees follows the links and reports every file
# identical, which is exactly the evidence that convinced one session to delete this
# directory as redundant -- breaking both skills. Check `ls -la` before trusting a
# byte-comparison across two paths.
#
# Only the loose scratch files at the top level are debris: API response dumps, server
# logs, timing captures. `.agents/specs/` is the build specs the parallel coding agents
# worked from -- useful locally, noise in a submission, and still cited by docstrings
# under src/recon/agents/.
/.agents/*.log
/.agents/*.json
/.agents/specs/

# Vendored third-party tooling, not project work. The diagrams it produced are content
# and live in docs/images/ with their editable .excalidraw sources.
/.claude/skills/excalidraw-diagram/

# uv lockfile from the vendored diagram tooling, not a project dependency
/uv.lock

# ── Agent tooling, not project work ───────────────────────────────────────────
# How this repo was built, not what was built. Kept on disk so the local setup
# keeps working; out of the submission so a reviewer sees the product.
# NOTE: .claude/skills/memory-systems and .claude/skills/remember are SYMLINKS
# into .agents/skills/ — do not "de-duplicate" them, see the note above.
/.agents/
/.claude/
/CLAUDE.md
/skills-lock.json
/.mcp.json

# Stray scratch diagram at the repo root, superseded by docs/images/.
/architecture.excalidraw
data/generated/*/vendor/
