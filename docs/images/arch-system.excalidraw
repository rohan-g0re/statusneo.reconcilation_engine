    {
      "type": "text",
      "id": "guide_header",
      "x": 90, "y": 848, "width": 400, "height": 25,
      "text": "READING THIS DIAGRAM",
      "originalText": "READING THIS DIAGRAM",
      "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400011, "version": 1, "versionNonce": 400012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "ellipse",
      "id": "guide_dot1",
      "x": 92, "y": 896, "width": 14, "height": 14,
      "strokeColor": "#3b82f6", "backgroundColor": "#3b82f6", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400013, "version": 1, "versionNonce": 400014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false
    },
    {
      "type": "text",
      "id": "guide_t1",
      "x": 118, "y": 892, "width": 410, "height": 57,
      "text": "The blue room is sealed. Every stage inside\nit is a pure function of its inputs; no model\ncall happens anywhere in it.",
      "originalText": "The blue room is sealed. Every stage inside\nit is a pure function of its inputs; no model\ncall happens anywhere in it.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400015, "version": 1, "versionNonce": 400016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "ellipse",
      "id": "guide_dot2",
      "x": 92, "y": 970, "width": 14, "height": 14,
      "strokeColor": "#3b82f6", "backgroundColor": "#3b82f6", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400017, "version": 1, "versionNonce": 400018, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false
    },
    {
      "type": "text",
      "id": "guide_t2",
      "x": 118, "y": 966, "width": 410, "height": 38,
      "text": "Flow runs one way. Feeds enter on the left,\nprojections leave at the bottom.",
      "originalText": "Flow runs one way. Feeds enter on the left,\nprojections leave at the bottom.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400019, "version": 1, "versionNonce": 400020, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "ellipse",
      "id": "guide_dot3",
      "x": 92, "y": 1026, "width": 14, "height": 14,
      "strokeColor": "#3b82f6", "backgroundColor": "#3b82f6", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400021, "version": 1, "versionNonce": 400022, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false
    },
    {
      "type": "text",
      "id": "guide_t3",
      "x": 118, "y": 1022, "width": 410, "height": 57,
      "text": "The agent layer hangs off the read API. It is\na consumer of projections, not a stage in\nthe pipeline.",
      "originalText": "The agent layer hangs off the read API. It is\na consumer of projections, not a stage in\nthe pipeline.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400023, "version": 1, "versionNonce": 400024, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "ellipse",
      "id": "guide_dot4",
      "x": 92, "y": 1100, "width": 14, "height": 14,
      "strokeColor": "#b45309", "backgroundColor": "#b45309", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400025, "version": 1, "versionNonce": 400026, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false
    },
    {
      "type": "text",
      "id": "guide_t4",
      "x": 118, "y": 1096, "width": 410, "height": 57,
      "text": "Exactly one write exists. It is drawn thin, it\npasses a human, and it lands in a table that\ncannot be updated or deleted.",
      "originalText": "Exactly one write exists. It is drawn thin, it\npasses a human, and it lands in a table that\ncannot be updated or deleted.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400027, "version": 1, "versionNonce": 400028, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },

