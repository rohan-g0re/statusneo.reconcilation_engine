    {
      "id": "RWCgU3LqosuRUaNhZWm_j",
      "type": "text",
      "x": 475.52674997740326,
      "y": 11273.384793154402,
      "width": 1806.0184326171875,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
