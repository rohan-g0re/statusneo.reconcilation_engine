      "link": null,
      "locked": false,
      "text": "pbm gen\n- Clients --> NCPDP B1, B2\n- manu side --> 835\n\nmedical gen\n- Clients --> 837\n- manu side --> 835\n\ntpa gen\n- Clients --> none\n- tpa side --> verity and cranware pulls\n\nbank gen\n- Clients --> none\n- client bank side --> bank statements\n\nbeacon gen\n- Clients --> data in one of the 2 formats\n- manu side --> something",
      "fontSize": 38,
      "baseFontSize": null,
