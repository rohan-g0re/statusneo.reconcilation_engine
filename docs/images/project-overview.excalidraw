    {
      "type": "text",
      "id": "RQu2Oe2vtNYhRfDQ_wry7",
      "x": 807.6026027943558,
      "y": 2356.741981746255,
      "width": 1603.125,
      "height": 22.5,
      "text": "Prove the state space before any data exists. Generate from it. Reconcile deterministically. Surface it. Then grade the engine against that same oracle.",
      "originalText": "Prove the state space before any data exists. Generate from it. Reconcile deterministically. Surface it. Then grade the engine against that same oracle.",
