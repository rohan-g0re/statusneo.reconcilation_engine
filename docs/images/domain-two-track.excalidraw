  {
   "type": "text",
   "id": "sql_text",
   "x": 1300,
   "y": 158,
   "width": 450,
   "height": 375,
   "text": "CREATE TABLE episode (\n  episode_id           TEXT PRIMARY KEY,\n  reimbursement_track  TEXT NOT NULL\n    CHECK (reimbursement_track IN ('PHARMACY','MEDICAL')),\n\n  rx_number            TEXT,   -- pharmacy identity\n  pharmacy_npi         TEXT,\n  clm01                TEXT,   -- medical identity\n  billing_provider_npi TEXT,\n\n  is_340b_flagged      INTEGER NOT NULL DEFAULT 0,\n  covered_entity_id    TEXT,\n\n\n\n\n\n  CHECK (\n    (reimbursement_track = 'PHARMACY'\n       AND rx_number IS NOT NULL AND clm01 IS NULL)\n    OR\n    (reimbursement_track = 'MEDICAL'\n       AND clm01 IS NOT NULL AND rx_number IS NULL)\n  )\n) STRICT;",
   "originalText": "CREATE TABLE episode (\n  episode_id           TEXT PRIMARY KEY,\n  reimbursement_track  TEXT NOT NULL\n    CHECK (reimbursement_track IN ('PHARMACY','MEDICAL')),\n\n  rx_number            TEXT,   -- pharmacy identity\n  pharmacy_npi         TEXT,\n  clm01                TEXT,   -- medical identity\n  billing_provider_npi TEXT,\n\n  is_340b_flagged      INTEGER NOT NULL DEFAULT 0,\n  covered_entity_id    TEXT,\n\n\n\n\n\n  CHECK (\n    (reimbursement_track = 'PHARMACY'\n       AND rx_number IS NOT NULL AND clm01 IS NULL)\n    OR\n    (reimbursement_track = 'MEDICAL'\n       AND clm01 IS NOT NULL AND rx_number IS NULL)\n  )\n) STRICT;",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 500005,
   "version": 1,
   "versionNonce": 500006,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "sql_comment",
   "x": 1300,
   "y": 353,
   "width": 450,
   "height": 60,
   "text": "  -- Exactly one reimbursement track.  Never both,\n  -- never neither.  Duplicate billing of a single\n  -- dispense is unrepresentable, not merely\n  -- flagged downstream.",
   "originalText": "  -- Exactly one reimbursement track.  Never both,\n  -- never neither.  Duplicate billing of a single\n  -- dispense is unrepresentable, not merely\n  -- flagged downstream.",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#ffffff",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 500007,
   "version": 1,
   "versionNonce": 500008,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "caption",
   "x": 1280,
   "y": 578,
   "width": 490,
   "height": 53,
   "text": "Billing one dispense to both roads is duplicate\nbilling. The schema makes it unrepresentable —\na CHECK constraint refuses the row.",
   "originalText": "Billing one dispense to both roads is duplicate\nbilling. The schema makes it unrepresentable —\na CHECK constraint refuses the row.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
