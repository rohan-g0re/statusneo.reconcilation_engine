    {"type":"text","id":"brA_foot","x":60,"y":950,"width":700,"height":17,"text":"340B owns no identifier. It borrows this key -- nothing to fall back on.","originalText":"340B owns no identifier. It borrows this key -- nothing to fall back on.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50021,"version":1,"versionNonce":50022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"brB_foot","x":860,"y":950,"width":720,"height":17,"text":"CLP01 echoes what we sent. REF*F8 is the only trail back to the old ICN.","originalText":"CLP01 echoes what we sent. REF*F8 is the only trail back to the old ICN.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50023,"version":1,"versionNonce":50024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"brC_only","x":1760,"y":648,"width":760,"height":17,"text":"the only bridge that crosses a gap between two universes","originalText":"the only bridge that crosses a gap between two universes","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b91c1c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50025,"version":1,"versionNonce":50026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"fo_loop_lbl","x":1340,"y":1486,"width":540,"height":18,"text":"every later arrival re-checks the parked pool backward","originalText":"every later arrival re-checks the parked pool backward","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#b45309","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40373,"version":1,"versionNonce":40374,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}

