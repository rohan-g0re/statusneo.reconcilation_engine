{"id":"tr2","type":"text","x":1713,"y":537,"width":134,"height":55,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140026,"version":1,"versionNonce":240026,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Medical 835\nremittance","originalText":"Medical 835\nremittance","fontSize":22,"baseFontSize":null,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"r2","autoResize":true,"lineHeight":1.25,"labelPosition":null},
{"id":"n2","type":"text","x":620,"y":660,"width":960,"height":75,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140027,"version":1,"versionNonce":240027,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The 835 also carries CLP07, the payer's own control number. It looks like a claim id\nand it is not — the payer reassigns it every time the claim is reprocessed.\nKey on CLP07 and one claim's history forks into unrelated pieces.","originalText":"The 835 also carries CLP07, the payer's own control number. It looks like a claim id\nand it is not — the payer reassigns it every time the claim is reprocessed.\nKey on CLP07 and one claim's history forks into unrelated pieces.","fontSize":20,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},

