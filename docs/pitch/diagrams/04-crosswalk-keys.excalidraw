{"id":"tr1","type":"text","x":1695,"y":247,"width":170,"height":55,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140016,"version":1,"versionNonce":240016,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"PBM remittance\nX12 835","originalText":"PBM remittance\nX12 835","fontSize":22,"baseFontSize":null,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"r1","autoResize":true,"lineHeight":1.25,"labelPosition":null},
{"id":"n1","type":"text","x":620,"y":370,"width":960,"height":75,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140017,"version":1,"versionNonce":240017,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The 835 does not carry Rx and fill separately — CLP01 reads 221055368FILL03,\nso the connector splits it on the word FILL and borrows the NPI off the batch header.\nBreaks when one feed spells the Rx 07845102 and the other 7845102.","originalText":"The 835 does not carry Rx and fill separately — CLP01 reads 221055368FILL03,\nso the connector splits it on the word FILL and borrows the NPI off the batch header.\nBreaks when one feed spells the Rx 07845102 and the other 7845102.","fontSize":20,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},

