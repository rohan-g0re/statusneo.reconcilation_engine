{"id":"tr3","type":"text","x":1682,"y":813,"width":195,"height":82.5,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140036,"version":1,"versionNonce":240036,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"340B TPA records\nqualification,\ndecision, rebate","originalText":"340B TPA records\nqualification,\ndecision, rebate","fontSize":22,"baseFontSize":null,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","containerId":"r3","autoResize":true,"lineHeight":1.25,"labelPosition":null},
{"id":"n3","type":"text","x":620,"y":950,"width":960,"height":75,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140037,"version":1,"versionNonce":240037,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The PBM's authorisation number never reaches the TPA, so there is no id to share —\nonly the facts of the dispense itself. On the medical side there is no prescription and\nso no Rx number, and two infusions of one drug at one site on one day are identical.","originalText":"The PBM's authorisation number never reaches the TPA, so there is no id to share —\nonly the facts of the dispense itself. On the medical side there is no prescription and\nso no Rx number, and two infusions of one drug at one site on one day are identical.","fontSize":20,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},

{"id":"bh","type":"text","x":120,"y":1080,"width":768,"height":36.25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140041,"version":1,"versionNonce":240041,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"The bank is different — it takes two hops","originalText":"The bank is different — it takes two hops","fontSize":29,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},

