{"id":"title","type":"text","x":120,"y":30,"width":729,"height":48.75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140001,"version":1,"versionNonce":240001,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"Which fields the system joins over","originalText":"Which fields the system joins over","fontSize":39,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},
{"id":"sub","type":"text","x":120,"y":100,"width":1412,"height":30,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":140002,"version":1,"versionNonce":240002,"isDeleted":false,"boundElements":[],"updated":1,"link":null,"locked":false,"text":"No identifier is shared by all four feeds. Three bridges carry the load, and each breaks for a known reason.","originalText":"No identifier is shared by all four feeds. Three bridges carry the load, and each breaks for a known reason.","fontSize":24,"baseFontSize":null,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":null,"autoResize":false,"lineHeight":1.25,"labelPosition":null},

