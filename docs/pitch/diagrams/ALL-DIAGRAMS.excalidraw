    {
      "id": "fP_MO_HmVB5Yo0wytKF2D",
      "type": "text",
      "x": 17839.420424986063,
      "y": 2935.5179543352,
      "width": 960,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
