      "link": null,
      "locked": false,
      "text": "PARK",
      "originalText": "PARK",
      "fontSize": 24,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XqkjzZPzTVXtWMGM5tl8K",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
