      "created": 1790165756184
    },
    {
      "id": "HAbd5H1k3QR2aD-I8tKDh",
      "type": "text",
      "x": 18549.58297498945,
      "y": 4992.578179639773,
      "width": 715.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 273479588,
      "version": 276,
      "versionNonce": 154009824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Episode E-000012 is born. No 340B record yet, so the rebate track\nreads C-00 — absent, which is not a defect.",
      "originalText": "Episode E-000012 is born. No 340B record yet, so the rebate track\nreads C-00 — absent, which is not a defect.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyk9",
      "created": 1790165756184
    },
    {
      "id": "N4gXOfW2FCe_VI0DtIvjG",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5127.578179639773,
      "width": 770.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 43410212,
      "version": 276,
      "versionNonce": 1767308576,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Beacon assigns a Beacon ID. This is the only record that publishes it;\nevery later Beacon payload looks it up.",
      "originalText": "Beacon assigns a Beacon ID. This is the only record that publishes it;\nevery later Beacon payload looks it up.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykA",
      "created": 1790165756184
    },
    {
      "id": "e8SkLJYxYSezU55pkBSKV",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5262.578179639773,
      "width": 660,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1336303268,
      "version": 276,
      "versionNonce": 964355296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Rebate track opens — C-03, qualified, request not yet filed.\nA TPA may assert this: qualification is the test it owns.",
      "originalText": "Rebate track opens — C-03, qualified, request not yet filed.\nA TPA may assert this: qualification is the test it owns.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykB",
      "created": 1790165756184
    },
    {
      "id": "5C2pgSshimY1PkZcSJxg1",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5397.578179639773,
      "width": 726.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2812452,
      "version": 276,
      "versionNonce": 1538939168,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Cited on the timeline, moves no verdict. Beacon validating a claim\nis not the manufacturer approving a rebate.",
      "originalText": "Cited on the timeline, moves no verdict. Beacon validating a claim\nis not the manufacturer approving a rebate.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykC",
      "created": 1790165756184
    },
    {
      "id": "2HKXRlWRf-QSEChAWNuUJ",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5532.578179639773,
      "width": 715.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1460798884,
      "version": 276,
      "versionNonce": 378226912,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Approved and paid, per the manufacturer. No bank row ever arrives\nto prove it — C-09, EXCEPTION.",
      "originalText": "Approved and paid, per the manufacturer. No bank row ever arrives\nto prove it — C-09, EXCEPTION.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykD",
      "created": 1790165756184
    },
    {
      "id": "xozJF8Nh1HR56KTQQbvDt",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5667.578179639773,
      "width": 704,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160018724,
      "version": 276,
      "versionNonce": 1632777504,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Names the settlement a deposit should carry. Nothing in the bank\nfeed does, so the rebate stays unreconciled.",
      "originalText": "Names the settlement a deposit should carry. Nothing in the bank\nfeed does, so the rebate stays unreconciled.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykE",
      "created": 1790165756184
    },
    {
      "id": "iuftAfbVY84gznPpy6HFg",
      "type": "text",
      "x": 18549.58297498945,
      "y": 5802.578179639773,
      "width": 759.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1996483748,
      "version": 276,
      "versionNonce": 1005530336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "NO_KEY_MATCH — held with its keys, re-checked on every later arrival.\nNine Beacon acknowledgements park this way in this build.",
      "originalText": "NO_KEY_MATCH — held with its keys, re-checked on every later arrival.\nNine Beacon acknowledgements park this way in this build.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykF",
      "created": 1790165756184
    },
    {
      "id": "cIUe6tNQAHtJVa6t5vG4W",
      "type": "rectangle",
      "x": 17389.58297498945,
      "y": 5952.578179639773,
      "width": 2480,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1629665316,
      "version": 276,
      "versionNonce": 529436960,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "ZBNjHi5jUEjJ39J4TD6xG"
