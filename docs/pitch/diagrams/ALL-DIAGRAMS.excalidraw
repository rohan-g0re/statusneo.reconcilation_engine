"versionNonce": 230041,
"isDeleted": false,
"boundElements": [],
"updated": 1,
"link": null,
"locked": false,
"text": "Creates the episode. E-000012 is born,\nkeyed on pharmacy NPI + Rx number +\nfill number + date of service.",
"originalText": "Creates the episode. E-000012 is born,\nkeyed on pharmacy NPI + Rx number +\nfill number + date of service.",
"fontSize": 22,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "left",
"verticalAlign": "top",
"containerId": null,
"autoResize": false,
"lineHeight": 1.25,
"labelPosition": null
},
{
"id": "d3_b2",
"type": "text",
"x": 640,
"y": 5783.75,
"width": 484.00000000000006,
"height": 82.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 2,
"strokeStyle": "solid",
"roughness": 1,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 130042,
"version": 1,
"versionNonce": 230042,
"isDeleted": false,
"boundElements": [],
"updated": 1,
"link": null,
"locked": false,
"text": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
"originalText": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
"fontSize": 22,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "left",
"verticalAlign": "top",
"containerId": null,
"autoResize": false,
"lineHeight": 1.25,
"labelPosition": null
},
{
"id": "d3_b3",
"type": "text",
"x": 640,
"y": 5977.5,
"width": 484.00000000000006,
"height": 55.0,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 2,
"strokeStyle": "solid",
"roughness": 1,
"opacity": 100,
"groupIds": [],
"frameId": null,
"roundness": null,
"seed": 130043,
"version": 1,
"versionNonce": 230043,
"isDeleted": false,
"boundElements": [],
"updated": 1,
"link": null,
"locked": false,
"text": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
"originalText": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
"fontSize": 22,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "left",
"verticalAlign": "top",
"containerId": null,
"autoResize": false,
"lineHeight": 1.25,
"labelPosition": null
},
{
