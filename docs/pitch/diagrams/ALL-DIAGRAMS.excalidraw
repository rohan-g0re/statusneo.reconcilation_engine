    {
      "id": "d3_tpark",
      "type": "text",
      "x": 445,
      "y": 6755,
      "width": 1030,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U9d0EUny6cC07YoXtKv8g"
      ],
      "frameId": null,
