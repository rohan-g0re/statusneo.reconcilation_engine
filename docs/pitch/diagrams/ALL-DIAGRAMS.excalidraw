      "versionNonce": 417938720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
      "originalText": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cybO",
      "created": null
    },
    {
      "id": "d3_b3",
      "type": "text",
      "x": 640,
      "y": 5977.5,
      "width": 484.00000000000006,
      "height": 55,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U9d0EUny6cC07YoXtKv8g"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 130043,
      "version": 10,
      "versionNonce": 858563808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "originalText": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cybP",
      "created": null
    },
    {
      "id": "d3_b4",
      "type": "text",
      "x": 640,
      "y": 6143.75,
      "width": 471.90000000000003,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U9d0EUny6cC07YoXtKv8g"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 130044,
      "version": 10,
      "versionNonce": 1594136864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "originalText": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cybQ",
      "created": null
    },
    {
      "id": "d3_b5",
      "type": "text",
      "x": 640,
      "y": 6323.75,
      "width": 447.70000000000005,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U9d0EUny6cC07YoXtKv8g"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 130045,
      "version": 10,
      "versionNonce": 1946487008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "originalText": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cybR",
      "created": null
    },
    {
      "id": "d3_b6",
      "type": "text",
      "x": 640,
      "y": 6517.5,
      "width": 496.1,
      "height": 55,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U9d0EUny6cC07YoXtKv8g"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 130046,
      "version": 10,
      "versionNonce": 22312224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "The manufacturer says $1,677.20 was paid.\nNo bank row ever arrives to prove it.",
      "originalText": "The manufacturer says $1,677.20 was paid.\nNo bank row ever arrives to prove it.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cybS",
      "created": null
    },
