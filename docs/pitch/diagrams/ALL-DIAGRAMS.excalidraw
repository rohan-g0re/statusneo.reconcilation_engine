      "version": 3,
      "versionNonce": 1150451996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Episode E-000012 is born. No 340B record yet, so the rebate track\nreads C-00 — absent, which is not a defect.",
      "originalText": "Episode E-000012 is born. No 340B record yet, so the rebate track\nreads C-00 — absent, which is not a defect.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7i",
      "created": null
    },
    {
      "id": "d4_e2",
      "type": "text",
      "x": 1160,
      "y": 8195,
      "width": 770.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160072,
      "version": 3,
      "versionNonce": 1688645284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Beacon assigns a Beacon ID. This is the only record that publishes it;\nevery later Beacon payload looks it up.",
      "originalText": "Beacon assigns a Beacon ID. This is the only record that publishes it;\nevery later Beacon payload looks it up.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7j",
      "created": null
    },
    {
      "id": "d4_e3",
      "type": "text",
      "x": 1160,
      "y": 8330,
      "width": 660,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160073,
      "version": 3,
      "versionNonce": 559676828,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Rebate track opens — C-03, qualified, request not yet filed.\nA TPA may assert this: qualification is the test it owns.",
      "originalText": "Rebate track opens — C-03, qualified, request not yet filed.\nA TPA may assert this: qualification is the test it owns.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7k",
      "created": null
    },
    {
      "id": "d4_e4",
      "type": "text",
      "x": 1160,
      "y": 8465,
      "width": 726.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160074,
      "version": 3,
      "versionNonce": 815872548,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Cited on the timeline, moves no verdict. Beacon validating a claim\nis not the manufacturer approving a rebate.",
      "originalText": "Cited on the timeline, moves no verdict. Beacon validating a claim\nis not the manufacturer approving a rebate.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7l",
      "created": null
    },
    {
      "id": "d4_e5",
      "type": "text",
      "x": 1160,
      "y": 8600,
      "width": 715.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160075,
      "version": 3,
      "versionNonce": 281143836,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Approved and paid, per the manufacturer. No bank row ever arrives\nto prove it — C-09, EXCEPTION.",
      "originalText": "Approved and paid, per the manufacturer. No bank row ever arrives\nto prove it — C-09, EXCEPTION.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7m",
      "created": null
    },
    {
      "id": "d4_e6",
      "type": "text",
      "x": 1160,
      "y": 8735,
      "width": 704,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160076,
      "version": 3,
      "versionNonce": 1144935844,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Names the settlement a deposit should carry. Nothing in the bank\nfeed does, so the rebate stays unreconciled.",
      "originalText": "Names the settlement a deposit should carry. Nothing in the bank\nfeed does, so the rebate stays unreconciled.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx7n",
      "created": null
    },
    {
      "id": "d4_e7",
      "type": "text",
      "x": 1160,
      "y": 8870,
      "width": 759.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 160077,
      "version": 3,
      "versionNonce": 1706444444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "NO_KEY_MATCH — held with its keys, re-checked on every later arrival.\nNine Beacon acknowledgements park this way in this build.",
      "originalText": "NO_KEY_MATCH — held with its keys, re-checked on every later arrival.\nNine Beacon acknowledgements park this way in this build.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
