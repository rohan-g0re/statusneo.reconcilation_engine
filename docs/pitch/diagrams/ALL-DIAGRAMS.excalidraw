    },
    {
      "id": "ZBNjHi5jUEjJ39J4TD6xG",
      "type": "text",
      "x": 17911.811307508982,
      "y": 5986.328179639773,
      "width": 1435.5433349609375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 601887652,
      "version": 277,
      "versionNonce": 1396084960,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Three doors, three authorities. Verity or Craneware may assert QUALIFICATION — the patient-definition test is the TPA's to own.\nBeacon and the manufacturer own APPROVAL and PAYMENT; a TPA relaying that answer is stored as relayed, never as asserted.\nSwapping Verity for Craneware swaps 78 rows, not a file — and the engine cannot tell which door a record came through.",
      "originalText": "Three doors, three authorities. Verity or Craneware may assert QUALIFICATION — the patient-definition test is the TPA's to own.\nBeacon and the manufacturer own APPROVAL and PAYMENT; a TPA relaying that answer is stored as relayed, never as asserted.\nSwapping Verity for Craneware swaps 78 rows, not a file — and the engine cannot tell which door a record came through.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "cIUe6tNQAHtJVa6t5vG4W",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cykH",
      "created": 1790165756184
    },
