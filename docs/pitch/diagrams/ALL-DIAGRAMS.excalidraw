      "version": 190,
      "versionNonce": 395387168,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "The 835 does not carry Rx and fill separately — CLP01 reads 221055368FILL03,\nso the connector splits it on the word FILL and borrows the NPI off the batch header.\nBreaks when one feed spells the Rx 07845102 and the other 7845102.",
      "originalText": "The 835 does not carry Rx and fill separately — CLP01 reads 221055368FILL03,\nso the connector splits it on the word FILL and borrows the NPI off the batch header.\nBreaks when one feed spells the Rx 07845102 and the other 7845102.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
