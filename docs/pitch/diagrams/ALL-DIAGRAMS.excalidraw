      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 130043,
      "version": 3,
      "versionNonce": 681592860,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "originalText": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx6c",
      "created": null
    },
    {
      "id": "d3_b4",
      "type": "text",
      "x": 640,
      "y": 6143.75,
      "width": 471.90000000000003,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 130044,
      "version": 3,
      "versionNonce": 1719457700,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "originalText": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx6d",
      "created": null
    },
    {
      "id": "d3_b5",
      "type": "text",
      "x": 640,
      "y": 6323.75,
      "width": 447.70000000000005,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 130045,
      "version": 3,
      "versionNonce": 1847125148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790080918423,
      "link": null,
      "locked": false,
      "text": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "originalText": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cx6e",
      "created": null
    },
    {
