"boundElements": [],
"updated": 1,
"link": null,
"locked": false,
"text": "The PBM's authorisation number never reaches the TPA, so there is no id to share —\nonly the facts of the dispense itself. On the medical side there is no prescription and\nso no Rx number, and two infusions of one drug at one site on one day are identical.",
"originalText": "The PBM's authorisation number never reaches the TPA, so there is no id to share —\nonly the facts of the dispense itself. On the medical side there is no prescription and\nso no Rx number, and two infusions of one drug at one site on one day are identical.",
"fontSize": 20,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "left",
"verticalAlign": "top",
"containerId": null,
"autoResize": false,
"lineHeight": 1.25,
"labelPosition": null
},
