      "updated": 1790169539087,
      "link": null,
      "locked": false,
      "text": "ITS CLAIM LINES\n\nthe allocator splits the deposit\nacross them, one episode each",
      "originalText": "ITS CLAIM LINES\n\nthe allocator splits the deposit\nacross them, one episode each",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "d5_bk3",
      "autoResize": true,
      "lineHeight": 1.25,
