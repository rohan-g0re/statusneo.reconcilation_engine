    {
      "id": "itOWwRiPRnBl42Locxzq8",
      "type": "text",
      "x": 17839.420424986063,
      "y": 3225.5179543352,
      "width": 960,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zlvKPet0L5xbMw3D758eT"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2111465636,
      "version": 190,
      "versionNonce": 1216752864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "The 835 also carries CLP07, the payer's own control number. It looks like a claim id\nand it is not — the payer reassigns it every time the claim is reprocessed.\nKey on CLP07 and one claim's history forks into unrelated pieces.",
      "originalText": "The 835 also carries CLP07, the payer's own control number. It looks like a claim id\nand it is not — the payer reassigns it every time the claim is reprocessed.\nKey on CLP07 and one claim's history forks into unrelated pieces.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyiB",
      "created": 1790165571636
