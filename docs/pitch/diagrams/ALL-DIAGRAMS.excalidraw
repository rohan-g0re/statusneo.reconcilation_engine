      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Rebate payment\nbatch\n\nday 54",
      "originalText": "Rebate payment\nbatch\n\nday 54",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "G_koQkfck8zb51Lmm3eET",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj0",
      "created": 1790165756183
    },
    {
      "id": "tvKqmbLtPr0OUNGTbCqtZ",
      "type": "text",
      "x": 15244.22201208264,
      "y": 4900.646551084337,
      "width": 459.8,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 412967588,
      "version": 238,
      "versionNonce": 153605344,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Creates the episode. E-000012 is born,\nkeyed on pharmacy NPI + Rx number +\nfill number + date of service.",
      "originalText": "Creates the episode. E-000012 is born,\nkeyed on pharmacy NPI + Rx number +\nfill number + date of service.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj1",
      "created": 1790165756183
    },
    {
      "id": "E1jp-yrdLs54RclK2LD9U",
      "type": "text",
      "x": 15244.22201208264,
      "y": 5080.646551084337,
      "width": 484.00000000000006,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 463564324,
      "version": 238,
      "versionNonce": 1570007328,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
      "originalText": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj2",
      "created": 1790165756183
    },
    {
      "id": "QYaCGBE_rdIEF1udNQcsa",
      "type": "text",
      "x": 15244.22201208264,
      "y": 5274.396551084337,
      "width": 484.00000000000006,
      "height": 55,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1226312100,
      "version": 238,
      "versionNonce": 1125791968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "originalText": "Same natural key again. The rebate track\nmoves forward; nothing is wrong yet.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj3",
      "created": 1790165756183
    },
    {
      "id": "7SRz44BobcB5VGULEoVCm",
      "type": "text",
      "x": 15244.22201208264,
      "y": 5440.646551084337,
      "width": 471.90000000000003,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1412379940,
      "version": 238,
      "versionNonce": 1030374688,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "originalText": "Its CLP01 reads 221055368FILL03. Split\nit on the word FILL and you are back to\nRx 221055368, fill 03. Same episode.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj4",
      "created": 1790165756183
    },
    {
      "id": "BQRIgpo-JNUFyGpolHCEB",
      "type": "text",
      "x": 15244.22201208264,
      "y": 5620.646551084337,
      "width": 447.70000000000005,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1515516068,
      "version": 238,
      "versionNonce": 1495276768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "originalText": "Carries no claim id at all. Its TRN02\nfinds the remittance; the allocator\nsplits the deposit across its claims.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj5",
      "created": 1790165756183
    },
    {
      "id": "LW26I0GwC9t1gs2LgGmJj",
      "type": "text",
      "x": 15244.22201208264,
      "y": 5814.396551084337,
      "width": 496.1,
      "height": 55,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wPj2hgeUdcd0trxot_Bnk"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 456604708,
      "version": 238,
      "versionNonce": 1579458848,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790169539088,
      "link": null,
      "locked": false,
      "text": "The manufacturer says $1,677.20 was paid.\nNo bank row ever arrives to prove it.",
      "originalText": "The manufacturer says $1,677.20 was paid.\nNo bank row ever arrives to prove it.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "index": "cyj6",
      "created": 1790165756183
    },
