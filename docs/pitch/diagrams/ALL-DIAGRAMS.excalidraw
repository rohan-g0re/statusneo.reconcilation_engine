"x": 0,
"y": 9020.0,
"width": 2480,
"height": 150,
"angle": 0,
"strokeColor": "#1971c2",
"backgroundColor": "#e9ecef",
"fillStyle": "solid",
"strokeWidth": 2,
"strokeStyle": "solid",
"roughness": 1,
"opacity": 100,
"groupIds": [],
