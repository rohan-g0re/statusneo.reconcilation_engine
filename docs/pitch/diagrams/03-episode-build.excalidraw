"version": 1,
"versionNonce": 230042,
"isDeleted": false,
"boundElements": [],
"updated": 1,
"link": null,
"locked": false,
"text": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
"originalText": "Builds the 340B natural key from its own\nfields — NPI + Rx + NDC + fill date —\nand finds the episode already there.",
"fontSize": 22,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "left",
"verticalAlign": "top",
"containerId": null,
"autoResize": false,
"lineHeight": 1.25,
"labelPosition": null
},
{
"id": "b3",
"type": "text",
"x": 760,
"y": 637.5,
"width": 484.00000000000006,
"height": 55.0,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 2,
"strokeStyle": "solid",
