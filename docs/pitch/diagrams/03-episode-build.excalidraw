},
{
"id": "b2",
"type": "text",
"x": 760,
"y": 443.75,
"width": 484.00000000000006,
"height": 82.5,
"angle": 0,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"strokeWidth": 2,
"strokeStyle": "solid",
