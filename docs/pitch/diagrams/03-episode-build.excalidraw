"updated": 1,
"link": null,
"locked": false,
"text": "If a record's keys resolve to nothing, it is PARKED — never dropped.\nEvery later arrival also looks backwards at the parked pool, so a deposit that\nbeat its own remittance to the door still finds it three weeks later.",
"originalText": "If a record's keys resolve to nothing, it is PARKED — never dropped.\nEvery later arrival also looks backwards at the parked pool, so a deposit that\nbeat its own remittance to the door still finds it three weeks later.",
"fontSize": 24,
"baseFontSize": null,
"fontFamily": 5,
"textAlign": "center",
"verticalAlign": "middle",
"containerId": "park",
"autoResize": true,
"lineHeight": 1.25,
"labelPosition": null
}
